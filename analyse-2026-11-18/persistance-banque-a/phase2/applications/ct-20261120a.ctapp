-- Linux FFI TCP transport. Numeric private IPv4 only, no DNS/account access.
local ffi=require('ffi')
require('uart').check_abi() -- Declares the shared clock once; opens no UART.
ffi.cdef[[
typedef struct { unsigned short family,port; unsigned char addr[4]; unsigned char zero[8]; } ct_mqtt_sockaddr;
typedef struct { int fd; short events,revents; } ct_mqtt_pollfd;
typedef struct { long sec,nsec; } ct_mqtt_time;
int socket(int,int,int); int connect(int,const void*,unsigned int); int close(int);
long send(int,const void*,unsigned long,int); long recv(int,void*,unsigned long,int);
int poll(ct_mqtt_pollfd*,unsigned long,int); int getsockopt(int,int,int,void*,unsigned int*);
int inet_pton(int,const char*,void*); unsigned short htons(unsigned short);
int usleep(unsigned int); int getpid(void);
typedef union { unsigned long alignment; unsigned char bytes[128]; } ct_mqtt_sigset;
int sigemptyset(ct_mqtt_sigset*); int sigaddset(ct_mqtt_sigset*,int);
int sigprocmask(int,const ct_mqtt_sigset*,ct_mqtt_sigset*);
int sigtimedwait(const ct_mqtt_sigset*,void*,const ct_mqtt_time*);
]]
local C=ffi.C;local M={}
assert(ffi.os=='Linux','Linux socket ABI required')
assert(ffi.sizeof('ct_mqtt_sockaddr')==16 and ffi.sizeof('ct_mqtt_pollfd')==8,'socket ABI')
function M.now() local ts=ffi.new('ct_time[1]');assert(C.clock_gettime(1,ts)==0,'clock_gettime');return tonumber(ts[0].sec)+tonumber(ts[0].nsec)/1e9 end
function M.pause() C.usleep(10000) end
function M.pid() return tonumber(C.getpid()) end
function M.stop_signals()
  -- Consume blocked TERM/INT synchronously. No Lua code runs in an async
  -- signal handler; the normal service path can restore termios safely.
  local set=ffi.new('ct_mqtt_sigset[1]');local previous=ffi.new('ct_mqtt_sigset[1]')
  assert(C.sigemptyset(set)==0 and C.sigaddset(set,2)==0 and C.sigaddset(set,15)==0 and C.sigprocmask(0,set,previous)==0,'signal mask')
  local zero=ffi.new('ct_mqtt_time[1]')
  return {
    poll=function() local n=C.sigtimedwait(set,nil,zero);if n==2 or n==15 then return true end;assert(n<0 and (ffi.errno()==11 or ffi.errno()==4),'signal wait');return false end,
    restore=function() return C.sigprocmask(2,previous,nil)==0 end,
  }
end
function M.transport(config)
  local t={fd=-1};local buf=ffi.new('char[4096]')
  function t:close() if self.fd>=0 then C.close(self.fd);self.fd=-1 end end
  function t:open()
    assert(self.fd<0,'socket already open');self.fd=tonumber(C.socket(2,0x80801,0));assert(self.fd>=0,'socket errno='..ffi.errno()) -- stream|nonblock|cloexec
    local addr=ffi.new('ct_mqtt_sockaddr[1]');addr[0].family=2;addr[0].port=C.htons(config.broker_port)
    assert(C.inet_pton(2,config.broker_ipv4,addr[0].addr)==1,'numeric IPv4')
    local result=C.connect(self.fd,addr,16);assert(result==0 or ffi.errno()==115,'connect errno='..ffi.errno())
  end
  function t:connected()
    assert(self.fd>=0,'socket closed');local p=ffi.new('ct_mqtt_pollfd[1]');p[0].fd=self.fd;p[0].events=4
    local result=C.poll(p,1,0);assert(result>=0 or ffi.errno()==4,'poll errno='..ffi.errno());if result<=0 then return false end
    local err=ffi.new('int[1]');local size=ffi.new('unsigned int[1]',4)
    assert(C.getsockopt(self.fd,1,4,err,size)==0,'getsockopt errno='..ffi.errno());assert(err[0]==0,'connect SO_ERROR='..tonumber(err[0])..' poll_revents='..tonumber(p[0].revents));return true
  end
  function t:write(data)
    local n=tonumber(C.send(self.fd,data,#data,0x4000)) -- MSG_NOSIGNAL
    if n<0 and (ffi.errno()==11 or ffi.errno()==4) then return 0 end
    assert(n>=0,'socket send errno='..ffi.errno());return n
  end
  function t:read()
    local n=tonumber(C.recv(self.fd,buf,4096,0));if n<0 and (ffi.errno()==11 or ffi.errno()==4) then return nil end
    assert(n~=0,'socket EOF');assert(n>0,'socket receive errno='..ffi.errno());return ffi.string(buf,n)
  end
  return t
end
return M
F service.lua 7246 31c57c6804c16ecc85c7747ced67012dd4a4f08780b50d0409a11844f5c9f80e
local directory = assert(arg[0]:match('^(.*[/\\])'))
package.path = directory .. '?.lua;' .. package.path
local Config = require('config')
local UART = require('uart')
local Net = require('net')
local MQTT = require('mqtt')
local json = require('cjson')
local Led = require('led')

io.stdout:setvbuf('no')
local mode = arg[1]
local private_dir = '/apps/ct'
local device = '/dev/ttyS1'
local loaded, config, targets = pcall(function()
  local c = Config.parse(Config.read(private_dir, 'broker.conf', 4096))
  local t = UART.config(Config.read(private_dir, 'targets.conf', 2047))
  return c, t
end)
if not loaded then print('CONFIG_REJECTED'); os.exit(21) end

if mode == '--check-config' then
  print('CONFIG_OK targets=2')
  return
end
if mode == '--network' then
  local loaded_keys, keys, host_key = pcall(function()
    return Config.read(private_dir, 'authorized_keys', 4096), Config.read(private_dir, 'ssh_host_key', 4096)
  end)
  if not loaded_keys then print('SSH_CONFIG_REJECTED'); os.exit(21) end
  local function write(path, data)
    local file = assert(io.open(path, 'wb'))
    assert(file:write(data))
    assert(file:close())
  end
  write('/run/ct/ssh/authorized_keys', keys)
  write('/run/ct/ssh/host_key', host_key)
  local command = table.concat({'/usr/libexec/ct/network.sh', config.lan_ipv4,
    config.lan_prefix, config.broker_ipv4, config.broker_port, config.admin_ipv4}, ' ')
  os.exit(os.execute(command) == 0 and 0 or 21)
end
assert(mode == '--run', 'service mode')

local function discovery(index)
  local label = index == 1 and 'CETHI' or 'IC3'
  local id = config.client_id .. '_' .. label:lower()
  return json.encode({
    name = 'Valeur brute', unique_id = id .. '_raw', state_topic = config.state_topics[index],
    value_template = '{{ value_json.current_raw }}',
    json_attributes_topic = config.state_topics[index],
    availability_topic = config.topic_prefix .. '/availability', expire_after = config.interval_seconds + 30,
    device = { identifiers = { id }, name = 'Cozytouch ' .. label }
  })
end

local mqtt = MQTT.new(config, Net.transport(config), print)
Led.set('working')
-- Health budget: 95 s of MQTT session time, not wall time. While the broker is
-- unreachable (Home Assistant still booting after a power cut), the service waits.
local health_budget, connected_seconds, last_tick = 95, 0, Net.now()
local stop = Net.stop_signals()
local uart
local terminal_code = 0
local function has_current_ack(topic)
  return mqtt.state == 'ready' and mqtt.acknowledged[topic] == (mqtt.latest[topic] or {}).payload
    and mqtt.latest[topic] ~= nil
end

local ok, reason = pcall(function()
  uart = UART.open_session(targets, Net.now, device)
  local next_read, pending_publish = 0, false
  local pair, pair_connection = {}, nil
  local read_index, sequence = 1, 0
  local online, stopping, ack_done = false, false, false
  for i, topic in ipairs(config.discovery_topics) do mqtt:set(topic, discovery(i), true) end
  mqtt:set_availability('offline')
  while true do
    stopping = stopping or stop.poll()
    local now = Net.now()
    if mqtt.state == 'ready' then connected_seconds = connected_seconds + (now - last_tick) end
    last_tick = now
    if not ack_done and terminal_code == 0 and connected_seconds >= health_budget then
      print('HEALTH_TIMEOUT connected_seconds=' .. health_budget)
      terminal_code, stopping = 31, true
    end
    if stopping and not uart.active and uart.stage ~= 'revision' then break end
    mqtt:step(now)
    local result = uart:step(stopping)
    if uart.ready and not online and not stopping then
      online = true
      mqtt:set_availability('online')
    end
    if result then
      print('READ_RESULT index=' .. result.index .. ' status=' .. result.status)
      if result.status ~= 'DONE' then
        terminal_code = (result.status == 'TIMEOUT') and 32 or 33
        break
      end
      if mqtt.state == 'ready' and pair_connection == mqtt.connections and not stopping then
        local d = result.data
        sequence = sequence + 1
        pair[result.index] = json.encode({
          status = 'DONE', value_semantics = 'main_parameter_raw',
          current_raw = d.current_raw, target_raw = d.target_raw,
          remaining_time_raw = d.remaining_time_raw, origin_raw = d.origin, rssi_raw = d.rssi,
          observed_monotonic_ms = math.floor(Net.now() * 1000), sequence = sequence
        })
        if result.index == 2 then
          for i, topic in ipairs(config.state_topics) do mqtt:set(topic, pair[i], false) end
          pending_publish, read_index = true, 1
          next_read = Net.now() + config.interval_seconds
        else
          read_index = 2
        end
      else
        pair, read_index, next_read = {}, 1, Net.now() + config.interval_seconds
      end
    end
    local ready = online and mqtt.state == 'ready'
      and mqtt.acknowledged[config.topic_prefix .. '/availability'] == 'online'
      and has_current_ack(config.discovery_topics[1]) and has_current_ack(config.discovery_topics[2])
    if pending_publish and (mqtt.state ~= 'ready' or pair_connection ~= mqtt.connections) then
      pending_publish, read_index, next_read = false, 1, Net.now() + config.interval_seconds
    end
    if ready and pending_publish and has_current_ack(config.state_topics[1])
        and has_current_ack(config.state_topics[2]) and not stopping then
      pending_publish = false
      if not ack_done then
        local ack_status = os.execute('/usr/libexec/ct/healthy')
        if ack_status ~= 0 then terminal_code = 34; break end
        ack_done = true
        print('HEALTH_OK counter_ack=verified')
      end
    end
    Led.set((ready and ack_done and not pending_publish) and 'ok' or 'working')
    if read_index == 2 and (not ready or pair_connection ~= mqtt.connections) then
      pair, read_index, next_read = {}, 1, Net.now() + config.interval_seconds
    end
    if not stopping and ready and not pending_publish and not uart.active
        and (read_index == 2 or Net.now() >= next_read) then
      if read_index == 1 then pair, pair_connection = {}, mqtt.connections end
      uart:start(read_index)
      print('READ_ARMED index=' .. read_index)
    end
    Net.pause()
  end
  if terminal_code == 0 and not ack_done then terminal_code = 31 end
end)
local restored = not uart or uart:close()
print('UART_CLEANUP restored=' .. tostring(restored))
if not ok then
  local label = tostring(reason):match('STM32_[A-Z_]+') or tostring(reason):match('UART_[A-Z_]+') or 'SERVICE_FAILURE'
  terminal_code = label:match('^STM32_') and 35 or 36
  print(label)
end
if not restored then terminal_code = 36 end
if terminal_code ~= 0 then Led.set('error') end
mqtt:set_availability('offline')
local cutoff = Net.now() + 6
if mqtt.state == 'ready' then
  while Net.now() < cutoff and mqtt.state == 'ready' and not mqtt:offline_acked() do
    mqtt:step(Net.now())
    Net.pause()
  end
end
if mqtt:offline_acked() then
  local sent = mqtt:graceful_disconnect(Net.now, Net.pause, cutoff)
  print('MQTT_DISCONNECT complete=' .. tostring(sent))
else
  mqtt:close_abrupt()
end
if not stop.restore() then terminal_code = 36 end
print('SERVICE_EXIT status=' .. terminal_code .. ' pubacks=' .. mqtt.acks)
os.exit(terminal_code)

