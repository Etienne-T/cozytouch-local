#!/bin/sh
export PATH=/sbin:/bin:/usr/sbin:/usr/bin
umask 077
set -eu
mount -t proc -o nodev,nosuid,noexec proc /proc
mount -t sysfs -o nodev,nosuid,noexec sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs -o nodev,nosuid,noexec tmpfs /run
test -c /dev/watchdog0 && watchdog -T 12 -t 3 /dev/watchdog0
test ! -d /sys/class/ubi/ubi0
test -r /proc/mtd
printf '%s\n' 'COZY_RESCUE_RO: MTD, no automatic UBI attach'
while :; do setsid cttyhack /bin/sh </dev/console >/dev/console 2>&1; done
